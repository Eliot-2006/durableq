    {
      "type": "row",
      "title": "Lease health",
      "id": 23,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Lease expirations, lease lost, stale transitions / s",
      "description": "expirations = claims that reclaimed an expired lease (a worker died or stalled); lease lost = a worker abandoned a job whose lease it could not renew; stale = a fenced transition was rejected because the attempt had moved on. All should be near zero in steady state; fencing makes stale/lost safe, not free.",
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(durableq_lease_expirations_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "expirations/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(durableq_lease_lost_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "lease lost/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(durableq_stale_transitions_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "stale/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Lease events by kind",
      "description": "Same lease signals split by job kind, to find the handler causing lost leases.",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
